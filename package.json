{
  "name": "raidguild-brand",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:package && next dev --turbopack",
    "build": "npm run publish:package-dev && next build --turbopack",
    "start": "next start",
    "generate:brand": "tsx scripts/generate-brand-artifacts.ts",
    "build:package": "npm run build --workspace=@raidguild/brand-system",
    "pack:package": "npm run pack:check --workspace=@raidguild/brand-system",
    "publish:package-dev": "npm run build:package && tsx scripts/publish-dev-package.ts",
    "check:brand": "tsx scripts/generate-brand-artifacts.ts --check",
    "test:brand": "npm run publish:package-dev && tsx --test tests/*.test.ts",
    "storybook": "npm run build:package && storybook dev -p 6006",
    "build-storybook": "npm run publish:package-dev && storybook build",
    "test:stories": "npm run build:package && vitest run --project=storybook",
    "lint": "eslint",
    "typecheck": "npm run build:package && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.1",
    "recharts": "^3.5.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "viem": "^2.55.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@raidguild/brand-system": "file:packages/brand-system",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/nextjs-vite": "^10.5.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "playwright": "^1.62.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.17",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  }
}
