{
  "$description": "Venture Beyond typography tokens (W3C Design Tokens format). Fonts: SIL OFL 1.1, derived from Archivo by Omnibus-Type.",
  "venture-beyond": {
    "family": {
      "upright": { "$type": "fontFamily", "$value": ["Venture Beyond", "system-ui", "sans-serif"], "$description": "font-style: normal (VentureBeyond-Variable.woff2)" },
      "italic": { "$type": "fontFamily", "$value": ["Venture Beyond", "system-ui", "sans-serif"], "$description": "font-style: italic (VentureBeyond-Italic-Variable.woff2), native Archivo italic, 10deg" },
      "retalic": { "$type": "fontFamily", "$value": ["Venture Beyond Retalic", "Venture Beyond", "system-ui", "sans-serif"], "$description": "font-style: normal (VentureBeyond-Retalic-Variable.woff2), reverse slant, -10deg" }
    },
    "weight": {
      "thin": { "$type": "fontWeight", "$value": 100 },
      "extralight": { "$type": "fontWeight", "$value": 200 },
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "width": {
      "$description": "CSS font-stretch (maps to the wdth axis, 62-125)",
      "extracondensed": { "$type": "dimension", "$value": "62.5%" },
      "condensed": { "$type": "dimension", "$value": "75%" },
      "semicondensed": { "$type": "dimension", "$value": "87.5%" },
      "normal": { "$type": "dimension", "$value": "100%" },
      "semiextended": { "$type": "dimension", "$value": "112.5%" },
      "extended": { "$type": "dimension", "$value": "125%" }
    },
    "display": {
      "leading": { "$type": "number", "$value": 0.88 },
      "tracking": { "$type": "dimension", "$value": "-0.005em" }
    },
    "role": {
      "venture": {
        "$type": "typography",
        "$description": "Approved lockup line 1: Extended Black Retalic",
        "$value": { "fontFamily": "{venture-beyond.family.retalic}", "fontWeight": "{venture-beyond.weight.black}", "fontStretch": "{venture-beyond.width.extended}", "fontStyle": "normal", "lineHeight": "{venture-beyond.display.leading}", "letterSpacing": "{venture-beyond.display.tracking}" }
      },
      "beyond": {
        "$type": "typography",
        "$description": "Approved lockup line 2: Extended Black Italic",
        "$value": { "fontFamily": "{venture-beyond.family.italic}", "fontWeight": "{venture-beyond.weight.black}", "fontStretch": "{venture-beyond.width.extended}", "fontStyle": "italic", "lineHeight": "{venture-beyond.display.leading}", "letterSpacing": "{venture-beyond.display.tracking}" }
      }
    }
  }
}
